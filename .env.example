# Shop Management System - Production Environment Variables
# ============================================================
# Copy this file to .env (for local) or set these directly in your platform dashboard (Railway, Render, etc.).
#
# NEVER commit real values to git. This file is safe to commit as a template.

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
# Railway / Render usually give you a DATABASE_URL or individual vars.
# Prefer the individual vars for clarity.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/shop_management_system
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# If your platform gives a single DATABASE_URL (common on Railway), you can also use:
# SPRING_DATASOURCE_URL=${DATABASE_URL}

# ------------------------------------------------------------
# Redis (for caching + rate limiting)
# ------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# Or individual:
# REDIS_HOST=localhost
# REDIS_PORT=6379

# ------------------------------------------------------------
# JWT Security (CRITICAL - generate strong random values)
# ------------------------------------------------------------
# Generate with:
#   openssl rand -base64 64
APP_JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_RANDOM_BASE64_STRING_MIN_64_CHARS

# Token lifetime (milliseconds). 86400000 = 24 hours.
app.jwtExpirationMs=86400000

# ------------------------------------------------------------
# Async Stock Reconciliation Thread Pool
# ------------------------------------------------------------
ASYNC_STOCK_CORE_POOL_SIZE=4
ASYNC_STOCK_MAX_POOL_SIZE=8
ASYNC_STOCK_QUEUE_CAPACITY=100

# ------------------------------------------------------------
# Database Connection Pool (HikariCP)
# ------------------------------------------------------------
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=10000

# ------------------------------------------------------------
# CORS (for frontend)
# ------------------------------------------------------------
# In production, set this to your actual frontend URL(s), comma-separated.
# Example: https://your-shop-frontend.vercel.app,https://admin.yourdomain.com
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------
# Optional: Spring Profile
# ------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod

# ------------------------------------------------------------
# Health Check
# ------------------------------------------------------------
# The app exposes /api/test as a simple health endpoint.
# Both the Dockerfile and railway.json are configured to use it.
